# Copy to appsettings.Development.json or set as environment variables

ASPNETCORE_ENVIRONMENT=Development

# SQL Server connection string
ConnectionStrings__SqlMyVirtualAcademy=Data Source=LOCALHOST\SQLEXPRESS;Initial Catalog=MYVIRTUALACADEMY;User ID=sa;Password=YOUR_PASSWORD;TrustServerCertificate=True

# JWT — use a random string of at least 32 characters
JwtSettings__SecretKey=CHANGE_ME_RANDOM_SECRET_MIN_32_CHARS
JwtSettings__Issuer=MyVirtualAcademy
JwtSettings__Audience=MyVirtualAcademyUsers
JwtSettings__AccessTokenExpiryMinutes=15
JwtSettings__RefreshTokenExpiryDays=7

# CORS — frontend origin
AllowedOrigins__0=http://localhost:5173
