{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlMyVirtualAcademy": "Data Source=LOCALHOST\\SQLEXPRESS;Initial Catalog=MYVIRTUALACADEMY;User ID=sa;Password=YOUR_SA_PASSWORD;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "Issuer": "MyVirtualAcademy",
    "Audience": "MyVirtualAcademyUsers",
    "SecretKey": "CHANGE_ME_USE_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "AllowedOrigins": [
    "http://localhost:5173"
  ],
  "StoragePath": "wwwroot"
}
